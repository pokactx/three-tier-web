generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Todo {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(255)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("todos")
}
